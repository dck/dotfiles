[core]
	editor = hx
	attributesFile = /Users/deck/.gitattributes
[user]
	name = Denis Usanov
	email = denis@usanov.info
	signingkey = /Users/deck/.ssh/id_rsa.pub
[push]
    default = simple

[includeIf "gitdir:~/work/toptal/"]
    path = ~/work/toptal/.gitconfig
[rebase]
    instructionFormat = [%<(14,trunc)%an] %s
	updateRefs = true
	autoStash = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[diff "sopsdiffer"]
	textconv = sops -d
[pull]
	rebase = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[rerere]
	enabled = true
[merge "weave"]
	name = weave merge driver
	driver = weave merge %O %A %B %L %P
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
